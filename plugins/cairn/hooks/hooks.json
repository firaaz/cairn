{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "exec_command|shell_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/checks/codex_pretool_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/checks/codex_posttool_reality.py"
          }
        ]
      }
    ]
  }
}
