{
  "_comment": "Methodology-tier settings template for Cairn-consuming projects. The canonical Claude Code settings path is .claude/settings.json; consumers compose this template with their own preferences. Slice A ships role_guard.py registration; AGENT_ROLE is unset on non-compressed slices, so the hook is a no-op there.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.slice-system/checks/reversibility-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.slice-system/checks/role_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.slice-system/checks/reality-check.sh"
          }
        ]
      }
    ]
  }
}
